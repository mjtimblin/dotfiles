{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.15",
    "@cortexkit/aft-opencode@0.56.1",
    ["@plannotator/opencode@0.27.15", {
      "workflow": "plan-agent",
      "planningAgents": ["plan"]
    }],
  ]
}

