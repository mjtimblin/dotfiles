{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "plugin": [
    "@slkiser/opencode-quota@3.8.7",
    "@tarquinen/opencode-dcp@3.1.12",
    "@plannotator/opencode@0.19.23",
    "@cortexkit/aft-opencode@0.31.1",
  ],
  "experimental": {
    "quotaToast": {
      "enabledProviders": ["openai", "zai"],
      "minIntervalMs": 300000, // 5 minutes between fetches
      "toastDurationMs": 10000, // Toast shows for 10 seconds
    },
  },
}

