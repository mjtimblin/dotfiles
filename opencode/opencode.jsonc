{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.15",
    "@cortexkit/aft-opencode@0.51.2",
    ["@plannotator/opencode@0.27.4", {
      "workflow": "plan-agent",
      "planningAgents": ["plan"]
    }],
  ],
  "provider": {
    "opencode-go": {
      "options": { "baseURL": "http://localhost:18905" },
      "models": {
        // Update by running:  curl -s https://opencode.ai/zen/go/v1/models | jq -r '.data[] | .id' | sed 's/^/        "/; s/$/": {},/'
        "minimax-m3": {},
        "minimax-m2.7": {},
        "minimax-m2.5": {},
        "kimi-k3": {},
        "kimi-k2.7-code": {},
        "kimi-k2.6": {},
        "longcat-2.0": {},
        "kimi-k2.5": {},
        "glm-5.2": {},
        "glm-5.3-flash": {},
        "glm-5.3": {},
        "glm-5.1": {},
        "glm-5": {},
        "deepseek-v4-pro": {},
        "deepseek-v4-flash": {},
        "deepseek-flash": {},
        "deepseek-v4.1-flash": {},
        "deepseek-v4-flash-vision-exp": {},
        "qwen3.7-max": {},
        "qwen3.8-max": {},
        "qwen3.8-flash": {},
        "qwen3.7-plus": {},
        "qwen3.6-plus": {},
        "qwen3.5-plus": {},
        "mimo-v2-pro": {},
        "mimo-v2-omni": {},
        "mimo-v2.5-pro": {},
        "mimo-v2.5": {},
        "hy4-preview": {},
        "hy3": {},
        "union-alpha": {},
        "hy3-preview": {},
        "gpt-5.6-luna": {},
        "grok-4.5": {},
        "grok-4.6": {},
        "muse-spark-1.3-contributor": {},
        "muse-spark-1.2-contributor": {},
        "omen-alpha": {}
      }
    }
  }
}

