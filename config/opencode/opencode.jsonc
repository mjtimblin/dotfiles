{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "kagi": {
      "type": "local",
      "command": ["npx", "-y", "kagi-cli", "mcp"]
    },
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.2.0",
    "@cortexkit/aft-opencode@0.58.2",
    ["@plannotator/opencode@0.27.24", {
      "workflow": "plan-agent",
      "planningAgents": ["plan"]
    }],
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": ""
      },
      "models": {}
    }
  }
}

