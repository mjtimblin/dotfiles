{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "kagi": {
      "type": "local",
      "command": ["docker", "run", "--rm", "-i", "-e", "KAGI_SESSION_TOKEN", "ghcr.io/mjtimblin/kagi-cli:latest", "mcp"],
      "environment": {
        "KAGI_SESSION_TOKEN": "{env:KAGI_SESSION_TOKEN}"
      }
    },
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.2.0",
    "@cortexkit/aft-opencode@0.58.2",
    ["@plannotator/opencode@0.27.24", {
      "workflow": "plan-agent",
      "planningAgents": ["plan"]
    }],
  ],
  "disabled_providers": ["opencode"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": ""
      },
      "models": {}
    }
  }
}

